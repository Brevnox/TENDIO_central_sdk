# ============================================================
# TendioCentral SDK — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---------------------------
# TendioCentral Connection
# ---------------------------

# Your app's client ID — find this in the TendioCentral admin dashboard
# after creating your application. Auto-read by the SDK.
TENDIOCENTRAL_CLIENT_ID=

# Your app's client secret — also found in the TendioCentral dashboard
# next to your client ID. Must be passed as `clientSecret` in the SDK config.
TENDIOCENTRAL_CLIENT_SECRET=

# (Optional) Override the TendioCentral server URL.
# Most developers do NOT need to set this — the SDK auto-resolves the URL
# based on NODE_ENV (production, development, staging).
# Only set this if you are pointing at a custom TendioCentral instance.
# TENDIOCENTRAL_URL=https://central.mytendio2.com

# ---------------------------
# OAuth / Redirect
# ---------------------------

# The full URL where TendioCentral will redirect users after login.
# This must match the route where your callback handler is mounted.
# Must be passed as `redirectUri` in the SDK config.
# Example: https://your-app.com/auth/callback
TENDIOCENTRAL_REDIRECT_URI=https://your-app.com/auth/callback

# ---------------------------
# Webhooks (optional)
# ---------------------------

# Secret used to verify incoming webhook payloads from TendioCentral.
# Find this in the TendioCentral dashboard under your app's webhook settings.
# Auto-read by the SDK. Leave blank if you are not using webhooks.
TENDIOCENTRAL_WEBHOOK_SECRET=

# ---------------------------
# Application Environment
# ---------------------------

# Standard Node.js environment variable. The SDK uses this to auto-resolve
# the TendioCentral server URL:
#   production  → https://central.mytendio2.com
#   development → Tendio dev server
#   staging     → Tendio dev server
NODE_ENV=development

# Which Tendio environment this instance targets (used for auto-registration).
# Valid values: development, staging, production
# Defaults to "production" if not set.
ENVIRONMENT=development

# ---------------------------
# Session
# ---------------------------

# A long random string used to sign session cookies (express-session).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
